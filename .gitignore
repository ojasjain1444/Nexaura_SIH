backend/.pytest_cache
backend/*.db
backend/.env
backend/.backend.lock

# Backend document ingestion (Phase 3): real/uploaded documents and
# generated intermediate output are never committed. .gitkeep files keep
# the directories present in a fresh checkout.
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep

# Graphify generated output
graphify-out/
