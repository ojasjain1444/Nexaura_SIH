# Copy this file to .env and adjust as needed.
# The backend starts and /api/health works with ALL of these left at their
# defaults — none of the AI/OCR/voice provider values are required yet.

# --- Service ---
ENVIRONMENT=development

# --- Database ---
# SQLite default for local development. PostgreSQL-compatible connection
# string format is supported for when Phase 2+ moves to Postgres, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/bis_sahayak
DATABASE_URL=sqlite:///./bis_sahayak.db

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- LLM provider (not used yet — Phase 4+) ---
LLM_PROVIDER=
LLM_API_KEY=

# --- Embedding provider (not used yet — Phase 4+) ---
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# --- OCR provider (not used yet — Phase 3+) ---
OCR_PROVIDER=

# --- Speech-to-text / text-to-speech providers (not used yet — Phase 7+) ---
STT_PROVIDER=
TTS_PROVIDER=

# --- Storage ---
STORAGE_PATH=./data
